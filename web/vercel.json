{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:ci",
  "outputDirectory": "dist/web/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fieldwork-api.vercel.app/api/:path*"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
