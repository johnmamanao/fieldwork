# Fieldwork local demo environment. Copy to .env (see README).
APP_NAME=Fieldwork
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=fieldwork
DB_USERNAME=fieldwork
DB_PASSWORD=fieldwork

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=array

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=hello@fieldwork.test
MAIL_FROM_NAME=Fieldwork

FILESYSTEM_DISK=local

# Dev only: migrate on start and seed the demo workspaces once.
AUTO_MIGRATE=true
AUTO_SEED=true

# Shared secret for the sample payment-provider webhook (HMAC-SHA256 of the raw body).
PAYMENT_WEBHOOK_SECRET=

# Host ports
GATEWAY_PORT=8080
MAILPIT_PORT=8025
DB_FORWARD_PORT=54329
